# App Store Connect API key (Users and Access -> Integrations -> App Store Connect API)
ASC_KEY_ID=ABCD123456
ASC_ISSUER_ID=12a3b456-7890-1234-5678-9abcdef01234

# Provide the .p8 private key either inline (newlines may be escaped as \n) ...
# ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ... or as a path to the downloaded .p8 file:
ASC_PRIVATE_KEY_PATH=/path/to/AuthKey_ABCD123456.p8

# Optional: vendor number, required only for sales/finance report downloads
# ASC_VENDOR_NUMBER=80000000
